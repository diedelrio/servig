generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  key   String @id
  value String
}

model EmailLog {
  id        Int       @id @default(autoincrement())
  to        String
  type      String
  subject   String
  entity    String?
  entityId  String?
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  DISABLED
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // ADMIN | RECEPCION | TECNICO | CLIENTE
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique // recurso:accion
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id                Int        @id @default(autoincrement())
  email             String     @unique
  firstName         String
  lastName          String
  passwordHash      String
  status            UserStatus @default(PENDING_EMAIL_VERIFICATION)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  roleId            Int
  role              Role       @relation(fields: [roleId], references: [id])
  createdAt         DateTime   @default(now())

  emailTokens     EmailVerificationToken[]
  resetTokens     PasswordResetToken[]
  refreshTokens   RefreshToken[]
  repairsReceived Repair[]
  statusChanges   RepairStatusHistory[]
  attachments     Attachment[]
  diagnoses       Diagnosis[]
  quotesCreated   QuoteVersion[]           @relation("QuoteCreatedBy")
  quotesSent      QuoteVersion[]           @relation("QuoteSentBy")
  customer        Customer?                @relation(fields: [customerId], references: [id])
  customerId      Int?
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  taxId     String?  @unique // DNI/NIF/CIF normalizado
  email     String?  @unique
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools   Tool[]
  users   User[] // cuentas del portal vinculadas
  repairs Repair[]
}

model Tool {
  id                Int       @id @default(autoincrement())
  customerId        Int
  customer          Customer  @relation(fields: [customerId], references: [id])
  type              String
  brand             String
  model             String
  serialNumber      String?
  purchaseDate      DateTime? @db.Date
  warrantyExpiresAt DateTime? @db.Date
  description       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  repairs Repair[]

  @@index([customerId])
}

enum RepairStatus {
  RECIBIDO
  EN_REVISION
  PRESUPUESTO_PENDIENTE_APROBACION
  PRESUPUESTO_APROBADO
  PRESUPUESTO_RECHAZADO
  PEDIDO_REPUESTOS_MARCA
  EN_REPARACION
  REPARADO
  LISTO_PARA_RETIRAR
  ENTREGADO
  CANCELADO
}

enum HistoryOrigin {
  STAFF
  CUSTOMER_LINK
  CUSTOMER_PORTAL
  SYSTEM
}

/// Contadores para numeración (clave p. ej. "REP-2026").
model Counter {
  key   String @id
  value Int
}

model Repair {
  id            Int          @id @default(autoincrement())
  number        String       @unique
  customerId    Int
  customer      Customer     @relation(fields: [customerId], references: [id])
  toolId        Int
  tool          Tool         @relation(fields: [toolId], references: [id])
  receivedAt    DateTime     @default(now())
  declaredFault String
  visualState   String
  accessories   String?
  inWarranty    Boolean      @default(false)
  requiresQuote Boolean      @default(true)
  notes         String?
  status        RepairStatus @default(RECIBIDO)
  receivedById  Int
  receivedBy    User         @relation(fields: [receivedById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  history     RepairStatusHistory[]
  attachments Attachment[]
  diagnoses   Diagnosis[]
  quote       Quote?

  @@index([customerId])
  @@index([toolId])
  @@index([status])
}

/// Solo se inserta: nunca se edita ni se borra.
model RepairStatusHistory {
  id         Int           @id @default(autoincrement())
  repairId   Int
  repair     Repair        @relation(fields: [repairId], references: [id])
  fromStatus RepairStatus?
  toStatus   RepairStatus
  userId     Int?
  user       User?         @relation(fields: [userId], references: [id])
  comment    String?
  origin     HistoryOrigin @default(STAFF)
  createdAt  DateTime      @default(now())

  @@index([repairId])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  repairId     Int
  repair       Repair   @relation(fields: [repairId], references: [id])
  filename     String // nombre original, solo para mostrar
  storageKey   String   @unique
  mime         String
  size         Int
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([repairId])
}

enum QuoteStatus {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
  VENCIDO
  CANCELADO
}

enum QuoteItemType {
  LABOR
  PART
  OTHER
}

/// Entradas de diagnóstico: solo se agregan, no se editan (trazabilidad).
model Diagnosis {
  id                Int      @id @default(autoincrement())
  repairId          Int
  repair            Repair   @relation(fields: [repairId], references: [id])
  text              String
  visibleToCustomer Boolean  @default(false)
  authorId          Int
  author            User     @relation(fields: [authorId], references: [id])
  createdAt         DateTime @default(now())

  @@index([repairId])
}

/// Un presupuesto por reparación; los cambios son versiones. El estado vive en cada versión.
model Quote {
  id             Int            @id @default(autoincrement())
  repairId       Int            @unique
  repair         Repair         @relation(fields: [repairId], references: [id])
  currentVersion Int            @default(1)
  createdAt      DateTime       @default(now())
  versions       QuoteVersion[]
}

model QuoteVersion {
  id          Int         @id @default(autoincrement())
  quoteId     Int
  quote       Quote       @relation(fields: [quoteId], references: [id])
  version     Int
  status      QuoteStatus @default(BORRADOR)
  notes       String?
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  sentAt      DateTime?
  validUntil  DateTime?
  sentById    Int?
  sentBy      User?       @relation("QuoteSentBy", fields: [sentById], references: [id])
  createdById Int
  createdBy   User        @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  items       QuoteItem[]

  @@unique([quoteId, version])
}

model QuoteItem {
  id          Int           @id @default(autoincrement())
  versionId   Int
  version     QuoteVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position    Int
  type        QuoteItemType
  description String
  quantity    Decimal       @db.Decimal(10, 2)
  unitPrice   Decimal       @db.Decimal(12, 2)
  taxRate     Decimal       @db.Decimal(5, 2)
  lineNet     Decimal       @db.Decimal(12, 2)
  lineTax     Decimal       @db.Decimal(12, 2)

  @@index([versionId])
}
